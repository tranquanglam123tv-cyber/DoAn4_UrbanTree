# ==========================================
# URBANTREE BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

PORT=5001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_super_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# Email OTP Service (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="UrbanTree Cần Thơ <noreply@urbantree.cantho.gov.vn>"

# Blockchain RPC & Private Key
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
DEPLOYER_PRIVATE_KEY=your_blockchain_operator_private_key_here
